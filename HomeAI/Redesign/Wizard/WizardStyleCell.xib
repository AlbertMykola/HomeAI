                <outlet property="previewImageView" destination="img" id="img-o"/>
                <outlet property="popularBadge" destination="pop" id="pop-o"/>
                <outlet property="customStack" destination="custom" id="custom-o"/>
                <outlet property="customIconBox" destination="pen-box" id="pen-box-o"/>
                <outlet property="describeLabel" destination="describe" id="describe-o"/>
                <outlet property="checkView" destination="check" id="check-o"/>
                <outlet property="titleLabel" destination="title" id="title-o"/>
            </connections>
        </collectionViewCell>
        </objects>
