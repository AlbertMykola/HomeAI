<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24127" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24063"/>
        <capability name="Image references" minToolsVersion="12.0"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <customFonts key="customFonts">
        <array key="Geologica-Medium.ttf">
            <string>Geologica-Medium</string>
        </array>
        <array key="Geologica-SemiBold.ttf">
            <string>Geologica-SemiBold</string>
        </array>
    </customFonts>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <collectionViewCell opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" id="cell" customClass="WizardTileCell" customModule="HomeAI" customModuleProvider="target" reuseIdentifier="WizardTileCell">
            <rect key="frame" x="0.0" y="0.0" width="109" height="112"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <view key="contentView" contentMode="scaleToFill" id="cell-content" userLabel="Content">
                <rect key="frame" x="0.0" y="0.0" width="109" height="112"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="tile" customClass="DSView" customModule="HomeAI" customModuleProvider="target" userLabel="tileView">
                        <subviews>
                            <stackView contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="col" opaque="NO" axis="vertical" alignment="center" spacing="8">
                                <subviews>
                                    <imageView contentMode="scaleAspectFit" clipsSubviews="YES" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="icon" userLabel="iconView" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                        <color key="tintColor" name="dsTextPrimary"/>
                                        <constraints>
                                            <constraint firstAttribute="width" constant="40" id="c3900"/>
                                            <constraint firstAttribute="height" constant="48" id="c3901"/>
                                        </constraints>
                                    </imageView>
                                    <label contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="label" userLabel="titleLabel" opaque="NO" text="Living room" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="YES" minimumScaleFactor="0.75" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                        <fontDescription key="fontDescription" name="Geologica-Medium" family="Geologica" pointSize="13"/><color key="textColor" name="dsTextPrimary"/><nil key="highlightedColor"/>
                                        <userDefinedRuntimeAttributes>
                                            <userDefinedRuntimeAttribute type="string" keyPath="locKey" value="Living room"/>
                                        </userDefinedRuntimeAttributes>
                                    </label>
                                </subviews>
                            </stackView>
                            <view contentMode="scaleToFill" alpha="0" translatesAutoresizingMaskIntoConstraints="NO" id="check" customClass="DSView" customModule="HomeAI" customModuleProvider="target" userLabel="checkView">
                                <subviews>
                                    <imageView contentMode="scaleAspectFit" clipsSubviews="YES" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="check-icon" image="checkmark" catalog="system" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                        <preferredSymbolConfiguration key="preferredSymbolConfiguration" configurationType="pointSize" pointSize="11" weight="bold"/>
                                        <color key="tintColor" name="dsLime"/>
                                    </imageView>
                                </subviews>
                                <color key="backgroundColor" name="dsInk"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="24" id="c3904"/>
                                    <constraint firstAttribute="height" constant="24" id="c3905"/>
                                    <constraint firstItem="check-icon" firstAttribute="centerX" secondItem="check" secondAttribute="centerX" id="c3906"/>
                                    <constraint firstItem="check-icon" firstAttribute="centerY" secondItem="check" secondAttribute="centerY" id="c3907"/>
                                </constraints>
                                <userDefinedRuntimeAttributes>
                                    <userDefinedRuntimeAttribute type="boolean" keyPath="pill" value="YES"/>
                                </userDefinedRuntimeAttributes>
                            </view>
                            <view contentMode="scaleToFill" hidden="YES" translatesAutoresizingMaskIntoConstraints="NO" id="badge" customClass="DSView" customModule="HomeAI" customModuleProvider="target" userLabel="badgeView">
                                <subviews>
                                    <label contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="badge-label" userLabel="badgeLabel" opaque="NO" text="Detected" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                        <fontDescription key="fontDescription" name="Geologica-SemiBold" family="Geologica" pointSize="10"/><color key="textColor" name="dsTextPrimary"/><nil key="highlightedColor"/>
                                        <userDefinedRuntimeAttributes>
                                            <userDefinedRuntimeAttribute type="string" keyPath="locKey" value="Detected"/>
                                        </userDefinedRuntimeAttributes>
                                    </label>
                                </subviews>
                                <color key="backgroundColor" name="dsCard"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="18" id="c3910"/>
                                    <constraint firstItem="badge-label" firstAttribute="leading" secondItem="badge" secondAttribute="leading" constant="7" id="c3911"/>
                                    <constraint firstItem="badge" firstAttribute="trailing" secondItem="badge-label" secondAttribute="trailing" constant="7" id="c3912"/>
                                    <constraint firstItem="badge-label" firstAttribute="centerY" secondItem="badge" secondAttribute="centerY" id="c3913"/>
                                </constraints>
                                <userDefinedRuntimeAttributes>
                                    <userDefinedRuntimeAttribute type="boolean" keyPath="pill" value="YES"/>
                                </userDefinedRuntimeAttributes>
                            </view>
                        </subviews>
                        <color key="backgroundColor" name="dsSurface"/>
                        <constraints>
                            <constraint firstItem="col" firstAttribute="centerX" secondItem="tile" secondAttribute="centerX" id="c3897"/>
                            <constraint firstItem="col" firstAttribute="centerY" secondItem="tile" secondAttribute="centerY" id="c3898"/>
                            <constraint firstItem="col" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="tile" secondAttribute="leading" constant="4" id="c3899"/>
                            <constraint firstItem="check" firstAttribute="top" secondItem="tile" secondAttribute="top" constant="6" id="c3902"/>
                            <constraint firstItem="tile" firstAttribute="trailing" secondItem="check" secondAttribute="trailing" constant="6" id="c3903"/>
                            <constraint firstItem="badge" firstAttribute="leading" secondItem="tile" secondAttribute="leading" constant="7" id="c3908"/>
                            <constraint firstItem="badge" firstAttribute="top" secondItem="tile" secondAttribute="top" constant="7" id="c3909"/>
                        </constraints>
                        <userDefinedRuntimeAttributes>
                            <userDefinedRuntimeAttribute type="number" keyPath="cornerRadius"><real key="value" value="24"/></userDefinedRuntimeAttribute>
                        </userDefinedRuntimeAttributes>
                    </view>
                </subviews>
                <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                <constraints>
                    <constraint firstItem="tile" firstAttribute="leading" secondItem="cell-content" secondAttribute="leading" id="c3893"/>
                    <constraint firstItem="tile" firstAttribute="top" secondItem="cell-content" secondAttribute="top" id="c3894"/>
                    <constraint firstItem="cell-content" firstAttribute="trailing" secondItem="tile" secondAttribute="trailing" id="c3895"/>
                    <constraint firstItem="cell-content" firstAttribute="bottom" secondItem="tile" secondAttribute="bottom" id="c3896"/>
                </constraints>
            </view>
            <connections>
                <outlet property="tileView" destination="tile" id="tile-o"/>
                <outlet property="iconView" destination="icon" id="icon-o"/>
                <outlet property="titleLabel" destination="label" id="label-o"/>
                <outlet property="checkView" destination="check" id="check-o"/>
                <outlet property="badgeView" destination="badge" id="badge-o"/>
                <outlet property="badgeLabel" destination="badge-label" id="badge-label-o"/>
            </connections>
        </collectionViewCell>
        </objects>
    <resources>
        <image name="checkmark" catalog="system" width="128" height="128"/>
        <namedColor name="dsCard">
            <color red="1.0000" green="1.0000" blue="1.0000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsInk">
            <color red="0.0000" green="0.0000" blue="0.0000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsLime">
            <color red="0.6471" green="0.9333" blue="0.1843" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsSurface">
            <color red="0.9686" green="0.9686" blue="0.9686" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsTextPrimary">
            <color red="0.0000" green="0.0000" blue="0.0000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
