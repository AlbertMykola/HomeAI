<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24127" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24063"/>
        <capability name="Image references" minToolsVersion="12.0"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <customFonts key="customFonts">
        <array key="Geologica-Medium.ttf">
            <string>Geologica-Medium</string>
        </array>
        <array key="Geologica-SemiBold.ttf">
            <string>Geologica-SemiBold</string>
        </array>
    </customFonts>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="DSToastView" customModule="HomeAI" customModuleProvider="target">
            <connections>
                <outlet property="contentView" destination="root" id="root-view-o"/>
                <outlet property="cardView" destination="card" id="card-o"/>
                <outlet property="iconView" destination="icon" id="icon-o"/>
                <outlet property="messageLabel" destination="label" id="label-o"/>
                <outlet property="actionLabel" destination="action" id="action-o"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root" userLabel="Root">
            <rect key="frame" x="0.0" y="0.0" width="353" height="48"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="card" customClass="DSView" customModule="HomeAI" customModuleProvider="target" userLabel="cardView">
                    <subviews>
                        <stackView contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="row" opaque="NO" alignment="center" spacing="10" layoutMarginsFollowReadableWidth="NO" layoutMarginsRelativeArrangement="YES">
                            <subviews>
                                <imageView contentMode="scaleAspectFit" clipsSubviews="YES" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="icon" userLabel="iconView" image="checkmark.circle" catalog="system" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                    <preferredSymbolConfiguration key="preferredSymbolConfiguration" configurationType="pointSize" pointSize="16" weight="semibold"/>
                                    <color key="tintColor" name="dsLime"/>
                                    <constraints>
                                        <constraint firstAttribute="width" constant="20" id="c57"/>
                                        <constraint firstAttribute="height" constant="20" id="c58"/>
                                    </constraints>
                                </imageView>
                                <label contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="label" userLabel="messageLabel" opaque="NO" text="Saved to Photos" textAlignment="natural" lineBreakMode="wordWrap" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                    <fontDescription key="fontDescription" name="Geologica-Medium" family="Geologica" pointSize="15"/><color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/><nil key="highlightedColor"/>
                                </label>
                                <label contentMode="scaleToFill" horizontalHuggingPriority="751" verticalHuggingPriority="251" horizontalCompressionResistancePriority="751" verticalCompressionResistancePriority="750" hidden="YES" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="action" userLabel="actionLabel" opaque="NO" text="Open" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO">
                                    <fontDescription key="fontDescription" name="Geologica-SemiBold" family="Geologica" pointSize="15"/><color key="textColor" name="dsLime"/><nil key="highlightedColor"/>
                                </label>
                            </subviews>
                            <edgeInsets key="layoutMargins" top="12" left="18" bottom="12" right="20"/>
                        </stackView>
                    </subviews>
                    <color key="backgroundColor" red="0.1373" green="0.1373" blue="0.1451" alpha="0.960" colorSpace="custom" customColorSpace="sRGB"/>
                    <constraints>
                        <constraint firstItem="row" firstAttribute="leading" secondItem="card" secondAttribute="leading" id="c53"/>
                        <constraint firstItem="row" firstAttribute="top" secondItem="card" secondAttribute="top" id="c54"/>
                        <constraint firstItem="card" firstAttribute="trailing" secondItem="row" secondAttribute="trailing" id="c55"/>
                        <constraint firstItem="card" firstAttribute="bottom" secondItem="row" secondAttribute="bottom" id="c56"/>
                        <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="48" id="c59"/>
                    </constraints>
                    <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="number" keyPath="cornerRadius"><real key="value" value="24"/></userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="number" keyPath="shadowOpacity"><real key="value" value="0.22"/></userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="number" keyPath="shadowRadius"><real key="value" value="16"/></userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="number" keyPath="shadowOffsetY"><real key="value" value="8"/></userDefinedRuntimeAttribute>
                    </userDefinedRuntimeAttributes>
                </view>
            </subviews>
            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <viewLayoutGuide key="safeArea" id="root-safeArea"/>
            <constraints>
                <constraint firstItem="card" firstAttribute="top" secondItem="root" secondAttribute="top" id="c49"/>
                <constraint firstItem="root" firstAttribute="bottom" secondItem="card" secondAttribute="bottom" id="c50"/>
                <constraint firstItem="card" firstAttribute="centerX" secondItem="root" secondAttribute="centerX" id="c51"/>
                <constraint firstItem="card" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="root" secondAttribute="leading" id="c52"/>
            </constraints>
        </view>
        </objects>
    <resources>
        <image name="checkmark.circle" catalog="system" width="128" height="128"/>
        <namedColor name="dsLime">
            <color red="0.6471" green="0.9333" blue="0.1843" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
