                            <constraint firstAttribute="height" constant="30" id="c1381"/>
                            <constraint firstItem="bookmark-icon" firstAttribute="centerX" secondItem="bookmark" secondAttribute="centerX" id="c1382"/>
                            <constraint firstItem="bookmark-icon" firstAttribute="centerY" secondItem="bookmark" secondAttribute="centerY" id="c1383"/>
                        </constraints>
                        <accessibility key="accessibilityConfiguration" label="Save idea"/>
