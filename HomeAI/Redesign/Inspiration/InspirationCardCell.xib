        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <collectionViewCell opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" id="cell" customClass="InspirationCardCell" customModule="HomeAI" customModuleProvider="target" reuseIdentifier="InspirationCardCell">
            <rect key="frame" x="0.0" y="0.0" width="170" height="230"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <view key="contentView" contentMode="scaleToFill" id="cell-content" userLabel="Content">
                <rect key="frame" x="0.0" y="0.0" width="170" height="230"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <imageView contentMode="scaleAspectFill" clipsSubviews="YES" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="photo" customClass="DSImageView" customModule="HomeAI" customModuleProvider="target" userLabel="photoImageView" horizontalHuggingPriority="1" verticalHuggingPriority="1" horizontalCompressionResistancePriority="1" verticalCompressionResistancePriority="1">
                        <color key="backgroundColor" red="0.9255" green="0.9255" blue="0.9255" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
                        <userDefinedRuntimeAttributes>
                            <userDefinedRuntimeAttribute type="number" keyPath="cornerRadius"><real key="value" value="20"/></userDefinedRuntimeAttribute>
                        </userDefinedRuntimeAttributes>
                    </imageView>
                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="tag" customClass="DSView" customModule="HomeAI" customModuleProvider="target" userLabel="tagView">
                        <subviews>
                            <stackView contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="tag-row" opaque="NO" alignment="center" spacing="0" layoutMarginsFollowReadableWidth="NO" layoutMarginsRelativeArrangement="YES">
                                <subviews>
                                    <label contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="tag-label" userLabel="tagLabel" opaque="NO" text="Japandi" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                        <fontDescription key="fontDescription" name="Geologica-Medium" family="Geologica" pointSize="12"/><color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/><nil key="highlightedColor"/>
                                        <userDefinedRuntimeAttributes>
                                            <userDefinedRuntimeAttribute type="string" keyPath="locKey" value="Japandi"/>
                                        </userDefinedRuntimeAttributes>
                                    </label>
                                </subviews>
                                <edgeInsets key="layoutMargins" top="0" left="10" bottom="0" right="10"/>
                            </stackView>
                        </subviews>
                        <color key="backgroundColor" red="0.0000" green="0.0000" blue="0.0000" alpha="0.350" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstAttribute="height" constant="26" id="c1392"/>
                            <constraint firstItem="tag-row" firstAttribute="leading" secondItem="tag" secondAttribute="leading" id="c1393"/>
                            <constraint firstItem="tag-row" firstAttribute="top" secondItem="tag" secondAttribute="top" id="c1394"/>
                            <constraint firstItem="tag" firstAttribute="trailing" secondItem="tag-row" secondAttribute="trailing" id="c1395"/>
                            <constraint firstItem="tag" firstAttribute="bottom" secondItem="tag-row" secondAttribute="bottom" id="c1396"/>
                        </constraints>
                        <userDefinedRuntimeAttributes>
