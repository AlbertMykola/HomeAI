                    <constraint firstItem="cell-content" firstAttribute="bottom" secondItem="tag" secondAttribute="bottom" constant="8" id="c1391"/>
                    <constraint firstItem="tag" firstAttribute="trailing" relation="lessThanOrEqual" secondItem="photo" secondAttribute="trailing" constant="-8" id="c1397"/>
