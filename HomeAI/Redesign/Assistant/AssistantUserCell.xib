        <tableViewCell opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" id="cell" customClass="AssistantUserCell" customModule="HomeAI" customModuleProvider="target" reuseIdentifier="AssistantUserCell">
            <rect key="frame" x="0.0" y="0.0" width="393" height="220"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <tableViewCellContentView key="contentView" contentMode="scaleToFill" id="cell-content" userLabel="Content">
                <rect key="frame" x="0.0" y="0.0" width="393" height="220"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <stackView contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="col" opaque="NO" axis="vertical" alignment="trailing" spacing="6">
                        <subviews>
