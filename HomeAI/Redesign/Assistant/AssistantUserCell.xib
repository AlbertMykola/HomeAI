                                <color key="backgroundColor" name="dsSurface"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="190" id="c130"/>
                                    <constraint firstAttribute="height" constant="136" id="c131"/>
                                </constraints>
                                <userDefinedRuntimeAttributes>
                                    <userDefinedRuntimeAttribute type="number" keyPath="cornerRadius"><real key="value" value="20"/></userDefinedRuntimeAttribute>
                                </userDefinedRuntimeAttributes>
                            </imageView>
                            <view contentMode="scaleToFill" clipsSubviews="YES" translatesAutoresizingMaskIntoConstraints="NO" id="bubble" customClass="DSGradientView" customModule="HomeAI" customModuleProvider="target" userLabel="bubbleView">
                                <subviews>
                                    <label contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="text" customClass="DSLabel" customModule="HomeAI" customModuleProvider="target" userLabel="messageLabel" opaque="NO" text="How can I make this living room feel warmer?" textAlignment="natural" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                        <fontDescription key="fontDescription" name="Geologica-Regular" family="Geologica" pointSize="15"/><color key="textColor" name="dsTextPrimary"/><nil key="highlightedColor"/>
                                        <constraints>
                                            <constraint firstAttribute="width" relation="lessThanOrEqual" constant="250" id="c136"/>
                                        </constraints>
                                        <userDefinedRuntimeAttributes>
                                            <userDefinedRuntimeAttribute type="number" keyPath="lineHeightMultiple"><real key="value" value="1.15"/></userDefinedRuntimeAttribute>
                                        </userDefinedRuntimeAttributes>
                                    </label>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="text" firstAttribute="leading" secondItem="bubble" secondAttribute="leading" constant="16" id="c132"/>
                                    <constraint firstItem="text" firstAttribute="top" secondItem="bubble" secondAttribute="top" constant="12" id="c133"/>
                                    <constraint firstItem="bubble" firstAttribute="trailing" secondItem="text" secondAttribute="trailing" constant="16" id="c134"/>
                                    <constraint firstItem="bubble" firstAttribute="bottom" secondItem="text" secondAttribute="bottom" constant="12" id="c135"/>
                                </constraints>
                                <userDefinedRuntimeAttributes>
                                    <userDefinedRuntimeAttribute type="color" keyPath="startColor"><color key="value" name="dsLimeTop"/></userDefinedRuntimeAttribute>
                                    <userDefinedRuntimeAttribute type="color" keyPath="endColor"><color key="value" name="dsLimeBottom"/></userDefinedRuntimeAttribute>
                                    <userDefinedRuntimeAttribute type="number" keyPath="angle"><real key="value" value="180"/></userDefinedRuntimeAttribute>
                                    <userDefinedRuntimeAttribute type="number" keyPath="cornerRadius"><real key="value" value="22"/></userDefinedRuntimeAttribute>
                                </userDefinedRuntimeAttributes>
                            </view>
                            <view contentMode="scaleToFill" hidden="YES" translatesAutoresizingMaskIntoConstraints="NO" id="error" customClass="DSPressableControl" customModule="HomeAI" customModuleProvider="target" userLabel="errorControl">
                                <subviews>
                                    <stackView contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="err-row" opaque="NO" alignment="center" spacing="6">
                                        <subviews>
                                            <imageView contentMode="scaleAspectFit" clipsSubviews="YES" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="err-icon" image="exclamationmark.circle.fill" catalog="system" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                                <preferredSymbolConfiguration key="preferredSymbolConfiguration" configurationType="pointSize" pointSize="13" weight="semibold"/>
                                                <color key="tintColor" red="0.8980" green="0.2824" blue="0.3020" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
                                                <constraints>
