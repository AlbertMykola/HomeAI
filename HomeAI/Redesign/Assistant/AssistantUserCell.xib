                                                    <constraint firstAttribute="height" constant="16" id="c142"/>
                                                </constraints>
                                            </imageView>
                                            <label contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="err-label" userLabel="errorLabel" opaque="NO" text="Couldn't send · Retry" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                                <fontDescription key="fontDescription" name="Geologica-Medium" family="Geologica" pointSize="13"/><color key="textColor" red="0.8980" green="0.2824" blue="0.3020" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/><nil key="highlightedColor"/>
                                            </label>
                                        </subviews>
