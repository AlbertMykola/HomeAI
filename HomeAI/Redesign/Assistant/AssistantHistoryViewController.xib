<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24127" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24063"/>
        <capability name="Image references" minToolsVersion="12.0"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <customFonts key="customFonts">
        <array key="Geologica-Regular.ttf">
            <string>Geologica-Regular</string>
        </array>
        <array key="Geologica-SemiBold.ttf">
            <string>Geologica-SemiBold</string>
        </array>
    </customFonts>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="AssistantHistoryViewController" customModule="HomeAI" customModuleProvider="target">
            <connections>
                <outlet property="view" destination="root" id="root-view-o"/>
                <outlet property="titleLabel" destination="title" id="title-o"/>
                <outlet property="tableView" destination="table" id="table-o"/>
                <outlet property="emptyLabel" destination="empty" id="empty-o"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root" userLabel="Root">
            <rect key="frame" x="0.0" y="0.0" width="393" height="640"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <stackView contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="header" opaque="NO" alignment="center" spacing="0">
                    <subviews>
                        <label contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="title" userLabel="titleLabel" opaque="NO" text="History" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                            <fontDescription key="fontDescription" name="Geologica-SemiBold" family="Geologica" pointSize="24"/><color key="textColor" name="dsTextPrimary"/><nil key="highlightedColor"/>
                        </label>
                        <view contentMode="scaleToFill" horizontalHuggingPriority="1" verticalHuggingPriority="250" translatesAutoresizingMaskIntoConstraints="NO" id="spacer">
                            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        </view>
                        <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="new" customClass="DSPressableControl" customModule="HomeAI" customModuleProvider="target">
                            <subviews>
                                <stackView contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="new-row" opaque="NO" alignment="center" spacing="8">
                                    <subviews>
                                        <imageView contentMode="scaleAspectFit" clipsSubviews="YES" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="new-icon" image="plus" catalog="system" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                            <preferredSymbolConfiguration key="preferredSymbolConfiguration" configurationType="pointSize" pointSize="15" weight="semibold"/>
                                            <color key="tintColor" name="dsTextPrimary"/>
                                            <constraints>
                                                <constraint firstAttribute="width" constant="18" id="c243"/>
                                                <constraint firstAttribute="height" constant="18" id="c244"/>
                                            </constraints>
                                        </imageView>
                                        <label contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="new-title" opaque="NO" text="New chat" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                                            <fontDescription key="fontDescription" name="Geologica-SemiBold" family="Geologica" pointSize="14"/><color key="textColor" name="dsTextPrimary"/><nil key="highlightedColor"/>
                                        </label>
                                    </subviews>
                                </stackView>
                            </subviews>
                            <color key="backgroundColor" name="dsLimeSoft"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="36" id="c240"/>
                                <constraint firstItem="new-row" firstAttribute="centerX" secondItem="new" secondAttribute="centerX" id="c241"/>
                                <constraint firstItem="new-row" firstAttribute="centerY" secondItem="new" secondAttribute="centerY" id="c242"/>
                                <constraint firstItem="new-row" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="new" secondAttribute="leading" constant="14" id="c248"/>
                            </constraints>
                            <userDefinedRuntimeAttributes>
                                <userDefinedRuntimeAttribute type="boolean" keyPath="pill" value="YES"/>
                                <userDefinedRuntimeAttribute type="string" keyPath="actionName" value="didTapNewChat:"/>
                            </userDefinedRuntimeAttributes>
                        </view>
                    </subviews>
                </stackView>
                <tableView contentMode="scaleToFill" clipsSubviews="YES" translatesAutoresizingMaskIntoConstraints="NO" id="table" userLabel="tableView" alwaysBounceVertical="YES" style="plain" separatorStyle="none" rowHeight="-1" estimatedRowHeight="-1" sectionHeaderHeight="-1" estimatedSectionHeaderHeight="-1" sectionFooterHeight="-1" estimatedSectionFooterHeight="-1" showsVerticalScrollIndicator="NO">
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                </tableView>
                <label contentMode="scaleToFill" hidden="YES" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="empty" userLabel="emptyLabel" opaque="NO" text="No conversations yet" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                    <fontDescription key="fontDescription" name="Geologica-Regular" family="Geologica" pointSize="15"/><color key="textColor" name="dsTextTertiary"/><nil key="highlightedColor"/>
                </label>
            </subviews>
            <color key="backgroundColor" name="dsBackground"/>
            <viewLayoutGuide key="safeArea" id="root-safeArea"/>
            <constraints>
                <constraint firstItem="header" firstAttribute="leading" secondItem="root" secondAttribute="leading" constant="20" id="c245"/>
                <constraint firstItem="root" firstAttribute="trailing" secondItem="header" secondAttribute="trailing" constant="20" id="c246"/>
                <constraint firstItem="header" firstAttribute="top" secondItem="root" secondAttribute="top" constant="28" id="c247"/>
                <constraint firstItem="table" firstAttribute="leading" secondItem="root" secondAttribute="leading" id="c249"/>
                <constraint firstItem="root" firstAttribute="trailing" secondItem="table" secondAttribute="trailing" id="c250"/>
                <constraint firstItem="root" firstAttribute="bottom" secondItem="table" secondAttribute="bottom" id="c251"/>
                <constraint firstItem="table" firstAttribute="top" secondItem="header" secondAttribute="bottom" constant="12" id="c252"/>
                <constraint firstItem="empty" firstAttribute="centerX" secondItem="root" secondAttribute="centerX" id="c253"/>
                <constraint firstItem="empty" firstAttribute="centerY" secondItem="root" secondAttribute="centerY" id="c254"/>
            </constraints>
        </view>
        </objects>
    <resources>
        <image name="plus" catalog="system" width="128" height="128"/>
        <namedColor name="dsBackground">
            <color red="1.0000" green="1.0000" blue="1.0000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsLimeSoft">
            <color red="0.9333" green="1.0000" blue="0.8392" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsTextPrimary">
            <color red="0.0000" green="0.0000" blue="0.0000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsTextTertiary">
            <color red="0.5569" green="0.5569" blue="0.5765" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
