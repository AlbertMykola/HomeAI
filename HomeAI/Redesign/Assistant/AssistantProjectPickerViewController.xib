<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24127" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24063"/>
        <capability name="Image references" minToolsVersion="12.0"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <customFonts key="customFonts">
        <array key="Geologica-Regular.ttf">
            <string>Geologica-Regular</string>
        </array>
        <array key="Geologica-SemiBold.ttf">
            <string>Geologica-SemiBold</string>
        </array>
    </customFonts>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="AssistantProjectPickerViewController" customModule="HomeAI" customModuleProvider="target">
            <connections>
                <outlet property="view" destination="root" id="root-view-o"/>
                <outlet property="titleLabel" destination="title" id="title-o"/>
                <outlet property="collectionView" destination="cv" id="cv-o"/>
                <outlet property="emptyLabel" destination="empty" id="empty-o"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root" userLabel="Root">
            <rect key="frame" x="0.0" y="0.0" width="393" height="700"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <label contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="title" userLabel="titleLabel" opaque="NO" text="From my projects" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                    <fontDescription key="fontDescription" name="Geologica-SemiBold" family="Geologica" pointSize="24"/><color key="textColor" name="dsTextPrimary"/><nil key="highlightedColor"/>
                </label>
                <collectionView contentMode="scaleToFill" clipsSubviews="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cv" userLabel="collectionView" multipleTouchEnabled="YES" showsHorizontalScrollIndicator="NO" showsVerticalScrollIndicator="NO" dataMode="none">
                    <collectionViewFlowLayout key="collectionViewLayout" minimumLineSpacing="13" minimumInteritemSpacing="13" id="cv-layout"><size key="itemSize" width="170" height="214"/><size key="headerReferenceSize" width="0.0" height="0.0"/><size key="footerReferenceSize" width="0.0" height="0.0"/><inset key="sectionInset" minX="20" minY="8" maxX="20" maxY="24"/></collectionViewFlowLayout>
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                </collectionView>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="close" customClass="DSPressableControl" customModule="HomeAI" customModuleProvider="target">
                    <subviews>
                        <imageView contentMode="scaleAspectFit" clipsSubviews="YES" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="close-icon" image="xmark" catalog="system" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                            <preferredSymbolConfiguration key="preferredSymbolConfiguration" configurationType="pointSize" pointSize="13.6" weight="semibold"/>
                            <color key="tintColor" name="dsTextPrimary"/>
                            <constraints>
                                <constraint firstAttribute="width" constant="16" id="c272"/>
                                <constraint firstAttribute="height" constant="16" id="c273"/>
                            </constraints>
                        </imageView>
                    </subviews>
                    <color key="backgroundColor" name="dsGlass"/>
                    <constraints>
                        <constraint firstAttribute="width" constant="36" id="c268"/>
                        <constraint firstAttribute="height" constant="36" id="c269"/>
                        <constraint firstItem="close-icon" firstAttribute="centerX" secondItem="close" secondAttribute="centerX" id="c270"/>
                        <constraint firstItem="close-icon" firstAttribute="centerY" secondItem="close" secondAttribute="centerY" id="c271"/>
                    </constraints>
                    <accessibility key="accessibilityConfiguration" label="Close"/>
                    <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="boolean" keyPath="pill" value="YES"/>
                        <userDefinedRuntimeAttribute type="number" keyPath="borderWidth"><real key="value" value="0.5"/></userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="color" keyPath="dsBorderColor"><color key="value" name="dsGlassBorder"/></userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="number" keyPath="shadowOpacity"><real key="value" value="0.08"/></userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="number" keyPath="shadowRadius"><real key="value" value="7"/></userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="number" keyPath="shadowOffsetY"><real key="value" value="4"/></userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="string" keyPath="actionName" value="didTapClose:"/>
                    </userDefinedRuntimeAttributes>
                </view>
                <label contentMode="scaleToFill" hidden="YES" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="empty" userLabel="emptyLabel" opaque="NO" text="No projects yet" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" horizontalHuggingPriority="251" verticalHuggingPriority="251">
                    <fontDescription key="fontDescription" name="Geologica-Regular" family="Geologica" pointSize="15"/><color key="textColor" name="dsTextTertiary"/><nil key="highlightedColor"/>
                </label>
            </subviews>
            <color key="backgroundColor" name="dsBackground"/>
            <viewLayoutGuide key="safeArea" id="root-safeArea"/>
            <constraints>
                <constraint firstItem="title" firstAttribute="leading" secondItem="root" secondAttribute="leading" constant="60" id="c274"/>
                <constraint firstItem="root" firstAttribute="trailing" secondItem="title" secondAttribute="trailing" constant="60" id="c275"/>
                <constraint firstItem="title" firstAttribute="top" secondItem="root" secondAttribute="top" constant="28" id="c276"/>
                <constraint firstItem="close" firstAttribute="top" secondItem="root" secondAttribute="top" constant="16" id="c277"/>
                <constraint firstItem="root" firstAttribute="trailing" secondItem="close" secondAttribute="trailing" constant="16" id="c278"/>
                <constraint firstItem="cv" firstAttribute="leading" secondItem="root" secondAttribute="leading" id="c279"/>
                <constraint firstItem="root" firstAttribute="trailing" secondItem="cv" secondAttribute="trailing" id="c280"/>
                <constraint firstItem="root" firstAttribute="bottom" secondItem="cv" secondAttribute="bottom" id="c281"/>
                <constraint firstItem="cv" firstAttribute="top" secondItem="title" secondAttribute="bottom" constant="12" id="c282"/>
                <constraint firstItem="empty" firstAttribute="centerX" secondItem="root" secondAttribute="centerX" id="c283"/>
                <constraint firstItem="empty" firstAttribute="centerY" secondItem="root" secondAttribute="centerY" id="c284"/>
            </constraints>
        </view>
        </objects>
    <resources>
        <image name="xmark" catalog="system" width="128" height="128"/>
        <namedColor name="dsBackground">
            <color red="1.0000" green="1.0000" blue="1.0000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsGlass">
            <color red="1.0000" green="1.0000" blue="1.0000" alpha="0.750" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsGlassBorder">
            <color red="1.0000" green="1.0000" blue="1.0000" alpha="0.900" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsTextPrimary">
            <color red="0.0000" green="0.0000" blue="0.0000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="dsTextTertiary">
            <color red="0.5569" green="0.5569" blue="0.5765" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
