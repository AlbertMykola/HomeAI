                            <constraint firstItem="card" firstAttribute="trailing" secondItem="texts" secondAttribute="trailing" constant="12" id="c175"/>
                            <constraint firstItem="apply" firstAttribute="top" secondItem="texts" secondAttribute="bottom" constant="10" id="c176"/>
                            <constraint firstItem="apply" firstAttribute="leading" secondItem="card" secondAttribute="leading" constant="12" id="c177"/>
                            <constraint firstItem="card" firstAttribute="trailing" secondItem="apply" secondAttribute="trailing" constant="12" id="c178"/>
