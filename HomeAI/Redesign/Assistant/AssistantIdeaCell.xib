                                <color key="backgroundColor" name="dsSurface"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="112" id="c172"/>
                                </constraints>
                            </imageView>
                            <stackView contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="texts" opaque="NO" axis="vertical" spacing="2">
                                <subviews>
