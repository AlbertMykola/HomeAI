        <collectionViewCell opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" id="cell" customClass="AssistantIdeaCell" customModule="HomeAI" customModuleProvider="target" reuseIdentifier="AssistantIdeaCell">
            <rect key="frame" x="0.0" y="0.0" width="236" height="218"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <view key="contentView" contentMode="scaleToFill" id="cell-content" userLabel="Content">
                <rect key="frame" x="0.0" y="0.0" width="236" height="218"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <view contentMode="scaleToFill" clipsSubviews="YES" translatesAutoresizingMaskIntoConstraints="NO" id="card" customClass="DSView" customModule="HomeAI" customModuleProvider="target">
